{
  "name": "10is-ball",
  "private": true,
  "version": "1.11.0",
  "description": "Tab-10 — closed table tennis tournament web service",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/verify/run-dev.mjs",
    "dev:pglite": "node scripts/verify/run-dev-pglite.mjs",
    "dev:ephemeral": "AUDIT_EPHEMERAL=1 DATABASE_URL= TEST_DATABASE_URL= PGLITE_DATA_DIR= pnpm run --parallel --filter @tab10/api --filter @tab10/web dev",
    "seed:local-players": "node scripts/seed-local-meme-players.mjs",
    "seed:audit": "node scripts/audit/seed-ephemeral.mjs",
    "build": "pnpm -r run build",
    "build:api": "pnpm --filter @tab10/shared --filter @tab10/test-utils run build && pnpm --filter @tab10/api run build",
    "build:web": "pnpm --filter @tab10/shared run build && pnpm --filter @tab10/web run build",
    "build:release": "pnpm run build:api && pnpm run build:web",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm test:fast",
    "test:fast": "node scripts/verify/run-fast.mjs",
    "test:postgres": "node scripts/verify/run-postgres.mjs",
    "test:migrations": "node scripts/verify/run-migrations.mjs",
    "test:e2e": "pnpm test:e2e:prodlike",
    "test:e2e:prodlike": "node scripts/verify/run-prodlike-e2e.mjs",
    "test:unit": "pnpm -r --filter './packages/*' --filter @tab10/api run test:unit",
    "test:integration": "pnpm --filter @tab10/api run test:integration",
    "test:load": "pnpm --filter @tab10/api run test:load",
    "backup:rehearsal": "bash scripts/backup-rehearsal.sh",
    "audit:docs": "node scripts/audit/check-docs.mjs",
    "audit:routes": "node scripts/audit/route-openapi-inventory.mjs --baseline docs/audit/evidence/route-openapi-inventory.json",
    "audit:routes:strict": "node scripts/audit/route-openapi-inventory.mjs --strict",
    "audit:secrets": "bash scripts/audit/secret-scan.sh",
    "audit:secrets:local": "bash scripts/audit/secret-scan.sh --include-local-env",
    "audit:secrets:self-test": "node scripts/audit/secret-scan.mjs --self-test",
    "audit:production": "node scripts/audit/capture-production-baseline.mjs",
    "smoke:public": "node scripts/release/smoke-current-main.mjs",
    "audit:reproduce-busy-bye": "node scripts/audit/reproduce-tournament-busy-bye.mjs",
    "audit:check": "pnpm audit:docs && pnpm audit:routes && pnpm audit:secrets:self-test && pnpm audit:secrets && pnpm audit:reproduce-busy-bye",
    "doctor": "node scripts/verify/doctor.mjs --require-docker --require-browser",
    "verify:fast": "node scripts/verify/doctor.mjs && pnpm --filter @tab10/shared --filter @tab10/test-utils run build && pnpm audit:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:fast",
    "verify:postgres": "node scripts/verify/run-postgres.mjs",
    "verify:e2e": "node scripts/verify/run-prodlike-e2e.mjs",
    "playwright:install": "playwright install chromium",
    "verify:all": "node scripts/verify/run-local.mjs",
    "ci": "pnpm run verify:all",
    "db:generate": "pnpm --filter @tab10/api run db:generate",
    "db:migrate": "node scripts/bin/run-compiled-migration.mjs",
    "test:ops-safety": "node --test scripts/ops-safety.test.mjs"
  },
  "engines": {
    "node": "24.20.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  }
}
