# Optional overrides for local development. `pnpm dev` supplies these
# loopback-only, non-secret defaults and starts the pinned compose service.
DATABASE_URL=postgresql://tab10_runtime:local@127.0.0.1:5432/tab10
MIGRATION_DATABASE_URL=postgresql://tab10_migration_owner:local@127.0.0.1:5432/tab10
NODE_ENV=development
TAB10_ENVIRONMENT=local
HOST=0.0.0.0
PORT=3001

# Comma-separated browser origins allowed when calling the API directly.
# WEB_ORIGIN=http://localhost:5173,https://your-app.example
# COOKIE_SAME_SITE=none

# Admin bootstrap is disabled by default, including in production. Enable it
# only for a deliberate one-time bootstrap and provide both values below.
SEED_ADMIN=0
# SEED_ADMIN_EMAIL=admin@your-domain.example
# The placeholder below is intentionally invalid. Use 10-128 characters with
# uppercase, lowercase, digit, and special-character coverage.
# SEED_ADMIN_PASSWORD=replace-with-a-unique-secret

# Schema changes are never applied by API startup. Use the dedicated direct URL:
# pnpm db:migrate -- --mode=apply

# A deployed artifact must set all three values; staging/production require a
# full 40-character SHA and always publish dirty=false.
# TAB10_RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
# TAB10_RELEASE_VERSION=1.10.1
# TAB10_ENVIRONMENT=staging
# TAB10_RELEASE_DIRTY=false

# Production migration also requires exact-SHA confirmation and allowlisted Neon
# target attestation. Render maps its immutable RENDER_GIT_COMMIT to the SHA
# variables in the checked-in start command; target values stay in provider
# configuration, not this file.
# TAB10_MIGRATION_CONFIRM_SHA=0123456789abcdef0123456789abcdef01234567
# TAB10_EXPECTED_NEON_PROJECT_ID=project-id
# TAB10_EXPECTED_NEON_BRANCH_ID=branch-id
# TAB10_EXPECTED_NEON_DATABASE=database-name

# PostgreSQL integration tests use a separate, loopback-only database whose
# name contains "test". Run them with NODE_ENV=test, DATABASE_URL unset, and
# explicit acknowledgement that the test schema will be dropped and recreated.
# ALLOW_TEST_DATABASE_RESET=1
# TEST_DATABASE_URL=postgresql://tab10_test:replace-me@127.0.0.1:5432/tab10_test
