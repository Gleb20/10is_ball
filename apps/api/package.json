{
  "name": "@tab10/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude 'src/postgres-date.integration.test.ts' --exclude 'src/db/migrations.postgres.integration.test.ts'",
    "test:fast": "vitest run --exclude 'src/postgres-date.integration.test.ts' --exclude 'src/db/migrations.postgres.integration.test.ts'",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration",
    "test:load": "vitest run src/load.integration.test.ts",
    "test:postgres": "REQUIRE_TEST_DATABASE_URL=1 vitest run --no-file-parallelism --silent=true src/db/migrations.postgres.integration.test.ts src/postgres-date.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:pglite": "tsx src/db/migrate-pglite.ts",
    "db:migrate:compiled": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@tab10/shared": "workspace:*",
    "@tab10/test-utils": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "nanoid": "^5.1.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
