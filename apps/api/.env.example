# Copy to apps/api/.env for local development. Never commit real credentials.
# Omit DATABASE_URL to use the local PGlite fallback.
DATABASE_URL=postgresql://tab10:replace-me@127.0.0.1:5432/tab10
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Comma-separated browser origins allowed when calling the API directly.
# WEB_ORIGIN=http://localhost:5173,https://your-app.example
# COOKIE_SAME_SITE=none

# Admin bootstrap is disabled by default, including in production. Enable it
# only for a deliberate one-time bootstrap and provide both values below.
SEED_ADMIN=0
# SEED_ADMIN_EMAIL=admin@your-domain.example
# The placeholder below is intentionally invalid. Use 10-128 characters with
# uppercase, lowercase, digit, and special-character coverage.
# SEED_ADMIN_PASSWORD=replace-with-a-unique-secret

# Schema application is enabled by default when DATABASE_URL is configured.
# MIGRATE_ON_BOOT=0

# PostgreSQL integration tests use a separate, loopback-only database whose
# name contains "test". Run them with NODE_ENV=test, DATABASE_URL unset, and
# explicit acknowledgement that the test schema will be dropped and recreated.
# ALLOW_TEST_DATABASE_RESET=1
# TEST_DATABASE_URL=postgresql://tab10_test:replace-me@127.0.0.1:5432/tab10_test
